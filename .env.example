# =====================================================================
# UNTOUCHABLE BARD — DISCORD VOICE INTEGRATION ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to `.env` (or `.env.local` for Next.js) and fill in your secrets.
# NEVER commit your real `.env` file to version control.
# NEVER prefix secrets with NEXT_PUBLIC_ (which would leak them to client browsers).

# ---------------------------------------------------------------------
# 1. DISCORD BOT CREDENTIALS
# Obtain these from https://discord.com/developers/applications
# ---------------------------------------------------------------------
# Your Discord Bot Token (Bot tab -> Reset Token / Copy Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Application ID (General Information tab)
DISCORD_APPLICATION_ID=your_application_id_here

# (Optional Default) Discord Server / Guild ID
# In Phase 5.1 Multi-Server mode, this is OPTIONAL: Untouchable Bard automatically discovers
# and lets you choose between all Discord servers where the bot is installed.
DISCORD_GUILD_ID=
# ---------------------------------------------------------------------
# 2. SERVICE-TO-SERVICE SECURITY SECRET
# Shared secret used to authenticate commands sent from Next.js server to Discord bot service.
# Keep this random and secret (e.g. openssl rand -hex 32).
# ---------------------------------------------------------------------
DISCORD_INTEGRATION_SECRET=change_this_to_a_secure_random_string_in_production

# ---------------------------------------------------------------------
# 3. INTERNAL NETWORKING
# Port where the local Discord bot service listens for API commands from Next.js
# ---------------------------------------------------------------------
DISCORD_BOT_PORT=3001
DISCORD_BOT_HOST=127.0.0.1
